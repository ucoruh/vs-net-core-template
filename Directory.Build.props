<Project>

  <!--
    Shared MSBuild settings for every project in this solution. Keeping them here instead of
    repeating them in each .csproj means the whole template only has one place to bump the
    target framework or turn a compiler switch on/off.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>

    <!-- Keep the sample warning-free: real warnings must be fixed, not hidden, so any new one fails the build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Reproducible builds: same inputs, same output path layout regardless of who/where builds it. -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' OR '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
