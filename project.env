# Project identity -- the ONE place a student renames the project.
# Every numbered script, every helper in scripts/ and the GitHub Actions workflow read this file
# (plain KEY=VALUE, no spaces around "=", no quotes). Release asset names are built from it:
#   <PROJECT_NAME>-<VERSION>[-<platform>[-<arch>]]-<content>[-<tool>].<ext>
PROJECT_NAME=calculator
VERSION=2.1.2

# Where the .NET pieces live. Change these when you rename the sample projects
# (see docs/guide/from-topic-to-project.en.md).
SOLUTION_FILE=CalculatorLibrary.sln
APP_PROJECT=CalculatorApp/CalculatorApp.csproj
TEST_PROJECT=CalculatorLibrary.Tests/CalculatorLibrary.Tests.csproj
LIBRARY_PROJECT=CalculatorLibrary/CalculatorLibrary.csproj
