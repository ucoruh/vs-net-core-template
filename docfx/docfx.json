{
  "metadata": [
    {
      "src": [
        {
          "src": "../CalculatorLibrary",
          "files": [ "CalculatorLibrary.csproj" ]
        }
      ],
      "dest": "api",
      "outputFormat": "mref",
      "disableGitFeatures": false,
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      { "files": [ "api/**.yml", "api/toc.yml" ] },
      { "files": [ "toc.yml", "index.md" ] }
    ],
    "resource": [
      { "files": [ "rteu_logo.jpg", "favicon.png" ], "src": "../docs/assets", "dest": "assets" }
    ],
    "globalMetadata": {
      "_appTitle": "Calculator API reference (DocFX)",
      "_appName": "calculator",
      "_appFooter": "API reference generated by DocFX from the XML doc comments. The main site is the MkDocs site one level up.",
      "_appLogoPath": "assets/rteu_logo.jpg",
      "_appFaviconPath": "assets/favicon.png",
      "_enableSearch": true
    },
    "template": [ "default", "modern", "templates/rteu" ],
    "xrefService": [ "https://xref.docs.microsoft.com/query?uid={uid}" ]
  }
}
